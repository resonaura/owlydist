        "archiver": "^5.3.1",
        "axios": "^1.2.2",
        "babel-jest": "^27.4.2",
        "babel-loader": "^8.2.3",
        "babel-plugin-named-asset-import": "^0.3.8",
        "babel-preset-react-app": "^10.0.1",
        "bfj": "^7.0.2",
        "bootstrap-icons": "^1.10.3",
        "browserslist": "^4.18.1",
        "camelcase": "^6.2.1",
        "css-loader": "^6.5.1",
        "dotenv": "^10.0.0",
        "dotenv-expand": "^5.1.0",
        "eslint": "^8.3.0",
        "eslint-config-react-app": "^7.0.1",
        "file-loader": "^6.2.0",
